# --- Auth API (Phase 1 : clé unique, header X-API-Key) ---
API_KEY=change-me

# Clé Fernet pour chiffrer les URLs RTSP en base. À générer avec :
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# --- PostgreSQL ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=surveillance

# --- MinIO / S3 ---
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=clips
# Endpoint vu depuis l'hôte (URLs présignées renvoyées par l'API)
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000

# --- Dashboard (Phase 4) ---
# URL de l'API vue depuis le navigateur (figée au build du frontend)
NEXT_PUBLIC_API_URL=http://localhost:8000
# Origines autorisées (CORS) pour l'API
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# --- Auth utilisateurs (Phase 5) ---
# Secret de signature des JWT. À générer avec :
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# --- Stripe (Phase 5, optionnel — vide = facturation désactivée) ---
# Clés de test : https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
# Secret du webhook (stripe listen --forward-to localhost:8000/billing/webhook)
STRIPE_WEBHOOK_SECRET=
# IDs des prix récurrents créés dans Stripe pour chaque plan
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=

# --- Worker vidéo ---
# ID de la caméra suivie par le worker : à remplir après POST /cameras, puis
# `docker compose up -d worker`.
WORKER_CAMERA_ID=
TARGET_FPS=8
BUFFER_SECONDS=60

# --- Analyse (Phase 2 : détection + tracking) ---
ANALYSIS_ENABLED=true
# Modèle pose : fournit les keypoints (mains, tête) utilisés par la Phase 3
YOLO_MODEL=yolov8n-pose.pt
ANALYSIS_FPS=5
# Seuil du signal person_dwell (secondes en zone)
DWELL_SECONDS=30
# Un track non revu pendant ce délai est expiré (IDs éphémères)
TRACK_TTL_SECONDS=5

# --- Moteur de comportements (Phase 3) ---
# Détection d'objets saisissables (règle dissimulation)
OBJECTS_ENABLED=true
OBJECT_MODEL=yolov8n.pt
# La détection d'objets tourne 1 frame d'analyse sur N
OBJECT_EVERY_N=2
# Fenêtre du clip d'alerte autour de l'événement
ALERT_CLIP_PRE_SECONDS=20
ALERT_CLIP_POST_SECONDS=20
# Les seuils du moteur de règles se règlent par caméra : PUT /cameras/{id}/settings
